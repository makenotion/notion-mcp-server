{
  "name": "@notionhq/notion-mcp-server",
  "keywords": [
    "notion",
    "api",
    "mcp",
    "server"
  ],
  "version": "2.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -build && node scripts/build-cli.js",
    "dev": "tsx watch scripts/start-server.ts",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage"
  },
  "bin": {
    "notion-mcp-server": "bin/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "express": "^4.22.3",
    "mustache": "^4.2.0",
    "node-fetch": "^3.3.2",
    "openapi-client-axios": "^7.9.1",
    "openapi-schema-validator": "^12.1.3",
    "openapi-types": "^12.1.3",
    "which": "^5.0.0",
    "yargs": "^17.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.19.43",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.25.12",
    "multer": "1.4.5-lts.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "^2.0.5"
    }
  },
  "description": "Official MCP server for Notion API",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makenotion/notion-mcp-server.git"
  },
  "author": "@notionhq",
  "bugs": {
    "url": "https://github.com/makenotion/notion-mcp-server/issues"
  },
  "homepage": "https://github.com/makenotion/notion-mcp-server#readme"
}
